# MongoDB
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB="jackGame"
MONGODB_COLLECTION="movies"

# Scrape target (Rotten Tomatoes editorial list)
SCRAPE_URL="https://editorial.rottentomatoes.com/guide/best-movies-21st-century/"

# Optional: value stored in Mongo for deduping
SOURCE_HOST="editorial.rottentomatoes.com"

# Server
PORT=3000

